diff --git a/src/test/java/com/hbh/interceptor/LoginInterceptorTest.java b/src/test/java/com/hbh/interceptor/LoginInterceptorTest.java
new file mode 100644
index 0000000..a9bf6d4
--- /dev/null
+++ b/src/test/java/com/hbh/interceptor/LoginInterceptorTest.java
@@ -0,0 +1,118 @@
+package com.hbh.interceptor;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import java.lang.reflect.InvocationHandler;
+import java.lang.reflect.Method;
+import java.lang.reflect.Proxy;
+import java.util.HashMap;
+import java.util.Map;
+
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+import javax.servlet.http.HttpSession;
+
+import org.junit.Test;
+
+import com.hbh.tools.Constants;
+
+public class LoginInterceptorTest {
+
+    @Test
+    public void managerWithoutSessionIsRedirected() throws Exception {
+        LoginInterceptor interceptor = new LoginInterceptor(Constants.Manager_SESSION, "/manager/login");
+        TestRequest request = new TestRequest(null);
+        TestResponse response = new TestResponse();
+        assertFalse(interceptor.preHandle(request.proxy(), response.proxy(), new Object()));
+        assertEquals("/market/manager/login", response.redirect);
+    }
+
+    @Test
+    public void managerWithSessionPasses() throws Exception {
+        LoginInterceptor interceptor = new LoginInterceptor(Constants.Manager_SESSION, "/manager/login");
+        TestRequest request = new TestRequest(session(Constants.Manager_SESSION, new Object()));
+        TestResponse response = new TestResponse();
+        assertTrue(interceptor.preHandle(request.proxy(), response.proxy(), new Object()));
+        assertNull(response.redirect);
+    }
+
+    @Test
+    public void wrongSessionKindIsRejected() throws Exception {
+        LoginInterceptor manager = new LoginInterceptor(Constants.Manager_SESSION, "/manager/login");
+        TestRequest request = new TestRequest(session(Constants.Staff_SESSION, new Object()));
+        TestResponse response = new TestResponse();
+        assertFalse(manager.preHandle(request.proxy(), response.proxy(), new Object()));
+        assertEquals("/market/manager/login", response.redirect);
+    }
+
+    @Test
+    public void staffWithSessionPasses() throws Exception {
+        LoginInterceptor staff = new LoginInterceptor(Constants.Staff_SESSION, "/staff/login");
+        TestRequest request = new TestRequest(session(Constants.Staff_SESSION, new Object()));
+        TestResponse response = new TestResponse();
+        assertTrue(staff.preHandle(request.proxy(), response.proxy(), new Object()));
+        assertNull(response.redirect);
+    }
+
+    private static HttpSession session(String key, Object value) {
+        Map<String, Object> attributes = new HashMap<String, Object>();
+        attributes.put(key, value);
+        InvocationHandler handler = new InvocationHandler() {
+            @Override
+            public Object invoke(Object proxy, Method method, Object[] args) {
+                if ("getAttribute".equals(method.getName())) {
+                    return attributes.get(args[0]);
+                }
+                return null;
+            }
+        };
+        return (HttpSession) Proxy.newProxyInstance(LoginInterceptorTest.class.getClassLoader(),
+                new Class<?>[]{HttpSession.class}, handler);
+    }
+
+    private static final class TestRequest {
+        private final HttpSession session;
+
+        TestRequest(HttpSession session) {
+            this.session = session;
+        }
+
+        HttpServletRequest proxy() {
+            InvocationHandler handler = new InvocationHandler() {
+                @Override
+                public Object invoke(Object proxy, Method method, Object[] args) {
+                    if ("getSession".equals(method.getName())) {
+                        return session;
+                    }
+                    if ("getContextPath".equals(method.getName())) {
+                        return "/market";
+                    }
+                    return null;
+                }
+            };
+            return (HttpServletRequest) Proxy.newProxyInstance(LoginInterceptorTest.class.getClassLoader(),
+                    new Class<?>[]{HttpServletRequest.class}, handler);
+        }
+    }
+
+    private static final class TestResponse {
+        private String redirect;
+
+        HttpServletResponse proxy() {
+            InvocationHandler handler = new InvocationHandler() {
+                @Override
+                public Object invoke(Object proxy, Method method, Object[] args) {
+                    if ("sendRedirect".equals(method.getName())) {
+                        redirect = (String) args[0];
+                    }
+                    return null;
+                }
+            };
+            return (HttpServletResponse) Proxy.newProxyInstance(LoginInterceptorTest.class.getClassLoader(),
+                    new Class<?>[]{HttpServletResponse.class}, handler);
+        }
+    }
+}
